# Roadie Environment Configuration

# Qloo API (Cultural Intelligence & Taste Graph)
# Get your API key at https://docs.qloo.com/
QLOO_API_KEY=your_qloo_api_key_here
QLOO_BASE_URL=https://api.qloo.com/v1

# Ticketmaster Discovery API (Venue & Event Discovery)
# Get your API key at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=your_ticketmaster_api_key_here

# Tavily API (Live Web Search & Real-Time Venue/Opener Verification)
# https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Setlist.fm API (Ground-truth Tour Backtesting)
# https://www.setlist.fm/settings/api
SETLIST_FM_API_KEY=your_setlist_fm_api_key_here

# Optional: LLM Provider for dynamic narrative enrichment
# Roadie runs out of the box with deterministic routing and heuristic fallback,
# but an LLM key can be provided for dynamic pitch customization.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
