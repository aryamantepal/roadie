# Copy to .env.local. Never commit real keys or use NEXT_PUBLIC_ for secrets.
# Empty keys exercise the existing sample-data workflow only.

# Required for a live Qloo-powered submission.
# Request access: https://docs.qloo.com/reference/qloo-llm-hackathon-developer-guide#getting-your-api-key
QLOO_API_KEY=
# Hackathon API server URL (hackathon keys only work with this URL; production/staging return 401)
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Optional venue discovery: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Optional live web enrichment: https://tavily.com/
TAVILY_API_KEY=
